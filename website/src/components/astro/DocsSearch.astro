---

<button
  type="button"
  data-cm-search-open
  aria-label="Search documentation and pages (Ctrl K)"
  aria-haspopup="dialog"
  aria-controls="cm-search-modal"
  class="inline-flex items-center justify-center gap-2 min-h-[44px] min-w-[44px] px-2.5 sm:px-3 rounded-lg border border-[var(--glass-border)] bg-[var(--glass-bg-subtle)] text-[var(--text-muted)] hover:border-[var(--accent-border)] hover:text-[var(--text-strong)] text-xs font-mono cursor-pointer transition-colors"
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8" />
    <line x1="21" y1="21" x2="16.65" y2="16.65" />
  </svg>
  <span class="hidden sm:inline">Search</span>
  <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] rounded bg-[var(--bg-code)] border border-[var(--glass-border)] text-[var(--text-dim)]" aria-hidden="true">
    Ctrl K
  </kbd>
</button>
