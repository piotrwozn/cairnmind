---
import tryOutput from '@/data/try-output.json';

// Show the core 3-step verbatim output lines (guarded by tests/test_website_sync.py)
const previewLines = tryOutput.lines.slice(0, tryOutput.lines.findIndex((l) => l.startsWith('Next steps'))).join('\n').trim();
const step1Copy = 'uvx cairnmind try';
const step2Copy = 'uv tool install cairnmind\ncairnmind init --backend sqlite\ncairnmind mcp generate --auto --write';
const step3Copy = 'cairnmind migrate --to server\ncairnmind models pull';
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="glass-elevated p-5 flex flex-col justify-between gap-3">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="glass-pill glass-pill-ok text-[11px] whitespace-nowrap">Step 1 · 15 seconds</span>
        <span class="font-mono text-[11px] text-[var(--text-dim)] whitespace-nowrap">Python 3.12+</span>
      </div>
      <h3 class="mt-3 text-lg font-semibold">Run the zero-risk sandbox</h3>
      <p class="mt-2 text-sm text-[var(--text-muted)] leading-relaxed">
        Ephemeral in-memory SQLite over a bundled sample project. Writes zero files and needs no Java, Docker, or GPU.
      </p>
    </div>
    <div class="space-y-2">
      <div class="relative">
        <pre class="code-block text-xs py-2.5 pl-3 pr-16 whitespace-pre"><code>$ uvx cairnmind try</code></pre>
        <button
          type="button"
          data-cm-copy={step1Copy}
          aria-label="Copy step 1 command"
          class="absolute top-1/2 -translate-y-1/2 right-1.5 inline-flex items-center min-h-[44px] px-2.5 rounded-md font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text-strong)] cursor-pointer bg-transparent border-0"
        >
          <span data-cm-copy-label>Copy</span>
        </button>
      </div>
      <p class="font-mono text-[11px] text-[var(--text-dim)]">
        No uv? → <code class="code-inline">pipx run cairnmind try</code>
      </p>
    </div>
  </div>

  <div class="glass-surface p-5 flex flex-col justify-between gap-3">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="glass-pill glass-pill-accent text-[11px] whitespace-nowrap">Step 2 · 2 minutes</span>
        <span class="font-mono text-[11px] text-[var(--text-dim)] whitespace-nowrap">SQLite + MCP</span>
      </div>
      <h3 class="mt-3 text-lg font-semibold">Connect your repo &amp; agent</h3>
      <p class="mt-2 text-sm text-[var(--text-muted)] leading-relaxed">
        Start light on local SQLite and auto-generate MCP presets for Claude Code, Codex CLI, Cursor, Windsurf, or VS Code.
      </p>
    </div>
    <div class="relative">
      <pre class="code-block text-[11.5px] py-2.5 pl-3 pr-16 whitespace-pre overflow-x-auto"><code>$ uv tool install cairnmind
$ cairnmind init --backend sqlite
$ cairnmind mcp generate \
    --auto --write</code></pre>
      <button
        type="button"
        data-cm-copy={step2Copy}
        aria-label="Copy step 2 commands"
        class="absolute top-1 right-1.5 inline-flex items-center min-h-[44px] px-2.5 rounded-md font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text-strong)] cursor-pointer bg-transparent border-0"
      >
        <span data-cm-copy-label>Copy</span>
      </button>
    </div>
  </div>

  <div class="glass-surface p-5 flex flex-col justify-between gap-3">
    <div>
      <div class="flex items-center justify-between gap-2">
        <span class="glass-pill text-[11px] whitespace-nowrap">Step 3 · Optional</span>
        <span class="font-mono text-[11px] text-[var(--text-dim)] whitespace-nowrap">Lossless scale</span>
      </div>
      <h3 class="mt-3 text-lg font-semibold">Scale to 12-language graph &amp; local LLM</h3>
      <p class="mt-2 text-sm text-[var(--text-muted)] leading-relaxed">
        When you want full code-graph impact across 12 languages or local Ollama Q&amp;A, migrate with zero data loss.
      </p>
    </div>
    <div class="relative">
      <pre class="code-block text-[11.5px] py-2.5 pl-3 pr-16 whitespace-pre overflow-x-auto"><code>$ cairnmind migrate --to server
$ cairnmind models pull</code></pre>
      <button
        type="button"
        data-cm-copy={step3Copy}
        aria-label="Copy step 3 commands"
        class="absolute top-1 right-1.5 inline-flex items-center min-h-[44px] px-2.5 rounded-md font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text-strong)] cursor-pointer bg-transparent border-0"
      >
        <span data-cm-copy-label>Copy</span>
      </button>
    </div>
  </div>
</div>

<!-- 100% verbatim CLI output captured from src/cairnmind/try_demo.py (checked by tests/test_website_sync.py) -->
<div class="mt-4 glass-surface p-4 sm:p-5" data-try-output-wrap>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
    <p class="font-mono text-xs text-[var(--accent)] font-semibold">
      Exact output when you run <code class="code-inline">uvx cairnmind try</code>
    </p>
    <a href="/install/" class="inline-flex items-center min-h-[44px] font-mono text-xs">
      Full Linux / macOS / Windows / Docker install →
    </a>
  </div>
  <pre data-try-output-pre class="code-block text-xs max-h-[210px] sm:max-h-none overflow-hidden sm:overflow-x-auto"><code>{previewLines}</code></pre>
  <button
    type="button"
    data-try-output-toggle
    aria-expanded="false"
    class="sm:hidden mt-2 inline-flex items-center min-h-[44px] px-3 rounded-lg font-mono text-xs border border-[var(--glass-border-hi)] bg-[var(--glass-bg-subtle)] text-[var(--text-strong)] cursor-pointer"
  >
    Show full output ↓
  </button>
</div>

<script>
  document.querySelectorAll('[data-try-output-wrap]').forEach((wrap) => {
    const pre = wrap.querySelector<HTMLElement>('[data-try-output-pre]');
    const btn = wrap.querySelector<HTMLButtonElement>('[data-try-output-toggle]');
    if (!pre || !btn) return;
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      pre.classList.toggle('max-h-[210px]', expanded);
      pre.classList.toggle('overflow-hidden', expanded);
      pre.classList.toggle('overflow-x-auto', !expanded);
      btn.textContent = expanded ? 'Show full output ↓' : 'Collapse output ↑';
    });
  });
</script>
