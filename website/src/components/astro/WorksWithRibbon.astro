---
/**
 * Monochrome brand marks for supported coding agents & editors.
 * Clean geometric SVG logomarks (zero external image requests).
 */
const TOOLS = [
  { id: 'claude', name: 'Claude Code' },
  { id: 'codex', name: 'Codex CLI' },
  { id: 'cursor', name: 'Cursor' },
  { id: 'copilot', name: 'GitHub Copilot' },
  { id: 'windsurf', name: 'Windsurf' },
  { id: 'vscode', name: 'VS Code' },
  { id: 'zed', name: 'Zed' },
  { id: 'cline', name: 'Cline' },
  { id: 'gemini', name: 'Gemini CLI' },
] as const;
---

<section aria-label="Compatible coding tools" class="py-5 border-y border-[var(--glass-border)] bg-[var(--glass-bg-subtle)]">
  <div class="container-shell flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
    <span class="font-mono text-xs uppercase tracking-wider text-[var(--text-muted)] font-semibold shrink-0">
      Works with your agents &amp; editors
    </span>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2.5 list-none p-0 m-0">
      {TOOLS.map((tool) => (
        <li class="inline-flex items-center gap-2 text-sm font-medium text-[var(--text-strong)]">
          {/* Claude / Anthropic starburst mark */}
          {tool.id === 'claude' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M12 1.5l1.55 6.95 5.08-4.98-3.03 6.45 6.9 1.65-6.6 2.53 3.92 5.95-5.72-4.24L12 22.5l-1.55-6.95-5.08 4.98 3.03-6.45-6.9-1.65 6.6-2.53-3.92-5.95 5.72 4.24L12 1.5z" />
            </svg>
          )}
          {/* OpenAI / Codex hexagonal knot mark */}
          {tool.id === 'codex' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M12 3.2a4.4 4.4 0 0 1 3.8 2.2l3.8 6.6a4.4 4.4 0 0 1-2.2 6l-5.4 2.8a4.4 4.4 0 0 1-6-1.6l-3.8-6.6a4.4 4.4 0 0 1 2.2-6L10 3.8A4.4 4.4 0 0 1 12 3.2z" />
              <polygon points="12,8 15.5,10 15.5,14 12,16 8.5,14 8.5,10" />
            </svg>
          )}
          {/* Cursor isometric cube + prism pointer */}
          {tool.id === 'cursor' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M12 2L3.5 6.9v10.2L12 22l8.5-4.9V6.9L12 2zm0 2.3l6.4 3.7-6.4 3.7L5.6 8 12 4.3zm-6.5 5.4L11 12.9v6.6l-5.5-3.2V9.7zm7.5 9.8v-6.6l5.5-3.2v6.6L13 19.5z" />
            </svg>
          )}
          {/* GitHub Copilot visor mark */}
          {tool.id === 'copilot' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M12 4c-3.8 0-6.5 1.8-7.4 4.8L3.5 11A2.5 2.5 0 0 0 2 13.3V15a2 2 0 0 0 2 2h1.4c1.2 1.8 3.7 3 6.6 3s5.4-1.2 6.6-3H20a2 2 0 0 0 2-2v-1.7a2.5 2.5 0 0 0-1.5-2.3l-1.1-2.2C18.5 5.8 15.8 4 12 4zm-3.2 6.2a2.2 2.2 0 0 1 2.2 2.2v1.2a2.2 2.2 0 1 1-4.4 0v-1.2a2.2 2.2 0 0 1 2.2-2.2zm6.4 0a2.2 2.2 0 0 1 2.2 2.2v1.2a2.2 2.2 0 1 1-4.4 0v-1.2a2.2 2.2 0 0 1 2.2-2.2z" />
            </svg>
          )}
          {/* Windsurf layered wave sail mark */}
          {tool.id === 'windsurf' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M3 16.5C6.2 11 9 7 12.2 7c2.2 0 2.8 2.2 3.8 4.4.8 1.8 1.7 3.1 4.8 1.6-2.5 4.4-5.2 6-7.7 6-2.4 0-3.3-2.2-4.3-4.3-.7-1.5-1.5-2.6-3.4-1.5L3 16.5z" />
            </svg>
          )}
          {/* VS Code folded ribbon mark */}
          {tool.id === 'vscode' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M17.6 2.3L9.3 10.1 4.4 6.4 2.5 7.5v9l1.9 1.1 4.9-3.7 8.3 7.8 3.9-1.9V4.2l-3.9-1.9zm-.4 5.2v9L12.1 12l5.1-4.5z" />
            </svg>
          )}
          {/* Zed geometric Z-frame mark */}
          {tool.id === 'zed' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="square" stroke-linejoin="miter" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="2.5" />
              <path d="M8 8.5h8l-8 7h8" />
            </svg>
          )}
          {/* Cline autonomous terminal-bot mark */}
          {tool.id === 'cline' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <rect x="3.5" y="6.5" width="17" height="12.5" rx="3.5" />
              <path d="M12 3v3.5" />
              <circle cx="9.2" cy="12.5" r="1.4" fill="currentColor" stroke="none" />
              <circle cx="14.8" cy="12.5" r="1.4" fill="currentColor" stroke="none" />
            </svg>
          )}
          {/* Gemini 4-point concave sparkle mark */}
          {tool.id === 'gemini' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--accent)] shrink-0" aria-hidden="true">
              <path d="M12 2c.7 5.2 4.8 9.3 10 10-5.2.7-9.3 4.8-10 10-.7-5.2-4.8-9.3-10-10 5.2-.7 9.3-4.8 10-10z" />
            </svg>
          )}
          <span>{tool.name}</span>
        </li>
      ))}
      <li class="font-mono text-xs text-[var(--text-dim)]">+ Roo Code, Claude Desktop &amp; any MCP client</li>
    </ul>
  </div>
</section>
