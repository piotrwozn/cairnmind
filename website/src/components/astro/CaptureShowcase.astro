<script>
  function hydrateLazyMedia(container: Element | null) {
    if (!container) return;
    const tpl = container.querySelector<HTMLTemplateElement>('template[data-lazy-media]');
    const slot = container.querySelector<HTMLElement>('[data-media-slot]');
    if (!tpl || !slot || slot.childElementCount > 0) return;
    slot.appendChild(tpl.content.cloneNode(true));
  }

  document.querySelectorAll('[data-showcase]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sc-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-sc-panel]'));

    const selectTab = (id: string) => {
      for (const tab of tabs) {
        const active = tab.dataset.scTab === id;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.className = active
          ? 'min-h-[44px] px-3.5 py-2 rounded-lg text-xs font-mono cursor-pointer transition-colors border bg-[var(--accent-surface)] text-[var(--text-strong)] border-[var(--accent-border)] font-semibold'
          : 'min-h-[44px] px-3.5 py-2 rounded-lg text-xs font-mono cursor-pointer transition-colors border bg-[var(--glass-bg-subtle)] text-[var(--text-muted)] border-[var(--glass-border)] hover:text-[var(--text-strong)]';
      }
      for (const panel of panels) {
        const active = panel.dataset.scPanel === id;
        panel.hidden = !active;
        if (active) hydrateLazyMedia(panel);
      }
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        if (t.dataset.scTab) selectTab(t.dataset.scTab);
      });
    });

    // Tab 1: Start on crisp static climax poster; auto-play 20s GIF when scrolled into viewport
    const liveWrap = root.querySelector('[data-live-gif-player]');
    if (liveWrap) {
      const btn = liveWrap.querySelector<HTMLButtonElement>('[data-live-gif-toggle]');
      const img = liveWrap.querySelector<HTMLImageElement>('[data-live-gif-img]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let playing = false;
      let userToggled = false;

      const setPlaying = (next: boolean) => {
        if (!btn || !img) return;
        playing = next;
        const target = playing ? btn.dataset.gifSrc : btn.dataset.posterSrc;
        if (target && img.getAttribute('src') !== target) img.src = target;
        btn.setAttribute('aria-pressed', playing ? 'true' : 'false');
        btn.textContent = playing ? '❚❚ Pause' : '▶ Play 20s Demo';
      };

      btn?.addEventListener('click', () => {
        userToggled = true;
        setPlaying(!playing);
      });

      if (!reduced && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.some((entry) => entry.isIntersecting);
            if (visible && !userToggled && !playing) {
              setPlaying(true);
              observer.disconnect();
            }
          },
          { threshold: 0.25 }
        );
        observer.observe(liveWrap);
      }
    }

    // Tab 2: Native HTML5 video Play/Pause toggle
    const videoWrap = root.querySelector('[data-video-player]');
    if (videoWrap) {
      const btn = videoWrap.querySelector<HTMLButtonElement>('[data-video-toggle]');
      const video = videoWrap.querySelector<HTMLVideoElement>('[data-handoff-video]');

      const syncBtn = () => {
        if (!btn || !video) return;
        const playing = !video.paused && !video.ended;
        btn.setAttribute('aria-pressed', playing ? 'true' : 'false');
        btn.textContent = playing ? '❚❚ Pause Recording' : '▶ Play Full Recording';
      };

      btn?.addEventListener('click', () => {
        if (!video) return;
        if (video.paused || video.ended) {
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
      video?.addEventListener('play', syncBtn);
      video?.addEventListener('pause', syncBtn);
      video?.addEventListener('ended', syncBtn);
    }

    // Lightbox zoom for Before/After comparison diagram (mounts SVG on first open)
    const dialog = root.querySelector<HTMLDialogElement>('[data-zoom-dialog]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-zoom-close]');
    root.querySelectorAll('[data-zoom-open]').forEach((el) => {
      el.addEventListener('click', () => {
        hydrateLazyMedia(dialog);
        dialog?.showModal();
      });
    });
    closeBtn?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
