---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import SupportedMatrix from '@/components/astro/SupportedMatrix.astro';
import InstallSwitcher from '@/components/islands/InstallSwitcher';
import installData from '@/data/install.json';
import { breadcrumbListJsonLd, softwareApplicationJsonLd } from '@/lib/seo';

const pathname = '/install/';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Install', href: pathname },
];
const jsonLd = [softwareApplicationJsonLd(), breadcrumbListJsonLd(crumbs)];
---

<BaseLayout
  title="Install Cairnmind on Linux, Windows, macOS & Docker"
  description="Try Cairnmind in 15 seconds with uvx cairnmind try, or install on Linux, WSL2, macOS, native Windows PowerShell, Docker, and any MCP client."
  pathname={pathname}
  jsonLd={jsonLd}
>
  <div class="container-shell section-band">
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <p class="eyebrow">Installation &amp; Topologies</p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold">
        Install Cairnmind on your platform
      </h1>
      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed">
        Start in 15 seconds with zero external services (<code class="code-inline">uvx cairnmind try</code>), or install the full pinned ArcadeDB 26.11.1 stack locally with Java 21, Docker, or a remote connect-only server. Every command on this page is verified against <a href="/docs/install/">docs/INSTALL.md</a> by automated tests.
      </p>
      <nav aria-label="Jump to platform" class="mt-6 flex flex-wrap gap-2">
        <a href="#try" class="glass-pill glass-pill-ok no-underline">15-Second Try</a>
        {installData.platforms.map((p) => (
          <a href={`#${p.id}`} class="glass-pill no-underline hover:border-[var(--accent-border)]">
            {p.label}
          </a>
        ))}
        <a href="#mcp-presets" class="glass-pill glass-pill-accent no-underline">MCP Presets</a>
      </nav>
    </header>

    <!-- Interactive OS switcher + Quick Try -->
    <section id="try" class="mt-10" aria-labelledby="try-heading">
      <h2 id="try-heading" class="sr-only">Quick platform switcher</h2>
      <InstallSwitcher client:visible />
      <p class="mt-3 font-mono text-xs text-[var(--text-muted)]">
        Requires Python 3.12+. Don’t have <code class="code-inline">uv</code>? Use <code class="code-inline">pipx run cairnmind try</code> or <code class="code-inline">pip install cairnmind</code>. Note: <code class="code-inline">scripts/install-wsl.sh</code> works on Linux, WSL2, and macOS from a cloned or unpacked release directory.
      </p>
    </section>

    <!-- All OS platforms rendered in full static HTML -->
    <div class="mt-8 space-y-6">
      {installData.platforms.map((platform) => (
        <section id={platform.id} class="glass-surface p-6 sm:p-8" aria-labelledby={`heading-${platform.id}`}>
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-[var(--glass-border)]">
            <h2 id={`heading-${platform.id}`} class="text-2xl font-semibold">{platform.label}</h2>
            <span class="glass-pill">{platform.badge}</span>
          </div>
          <p class="mt-3 text-sm sm:text-base text-[var(--text-muted)] leading-relaxed max-w-3xl">
            {platform.summary}
          </p>

          <div class="mt-5 grid grid-cols-1 lg:grid-cols-2 gap-4">
            <div class="space-y-2">
              <p class="font-mono text-xs text-[var(--accent)]">{platform.prereqLabel}</p>
              <pre class="code-block"><code>{platform.prereqCommands.join('\n')}</code></pre>
            </div>
            <div class="space-y-2">
              <p class="font-mono text-xs text-[var(--accent)]">{platform.installLabel}</p>
              <pre class="code-block"><code>{platform.installCommands.join('\n')}</code></pre>
            </div>
          </div>

          <div class="mt-4 space-y-2">
            <p class="font-mono text-xs text-[var(--text-dim)]">{platform.manualLabel}</p>
            <pre class="code-block"><code>{platform.manualCommands.join('\n')}</code></pre>
          </div>
        </section>
      ))}
    </div>

    <!-- First Project & Universal MCP Presets -->
    <section id="mcp-presets" class="mt-10 grid grid-cols-1 lg:grid-cols-12 gap-6" aria-labelledby="mcp-heading">
      <div class="lg:col-span-6 glass-surface p-6 sm:p-7">
        <p class="eyebrow">First Project</p>
        <h2 id="mcp-heading" class="mt-1 text-2xl font-semibold">Register a project &amp; bind assistants</h2>
        <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">
          Works immediately without Ollama or GPU. <code class="code-inline">cairnmind install</code> writes configuration only for coding clients actually installed on your machine.
        </p>
        <pre class="code-block mt-4"><code>{installData.firstProjectFlow.join('\n')}</code></pre>
      </div>

      <div class="lg:col-span-6 glass-surface p-6 sm:p-7 flex flex-col justify-between gap-4">
        <div>
          <p class="eyebrow">Universal MCP Generator</p>
          <h2 class="mt-1 text-2xl font-semibold">Built-in MCP client presets</h2>
          <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">
            Generate or safely deep-merge JSON, JSONC, and TOML MCP entries with atomic writes, <code class="code-inline">.cairnmind.bak</code> backups, and zero auto-approval flags:
          </p>
          <pre class="code-block mt-4"><code>cairnmind mcp generate --client cursor --write
cairnmind mcp test-connection
cairnmind doctor --check-mcp</code></pre>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {installData.mcpClients.map((client) => (
              <span class="glass-pill text-[11px]">{client}</span>
            ))}
          </div>
        </div>
        <div class="pt-3 border-t border-[var(--glass-border)] flex flex-wrap gap-4 text-xs font-mono">
          <a href="/docs/install/">Complete docs/INSTALL.md →</a>
          <a href="/docs/deployment/">Remote DB &amp; Kubernetes →</a>
          <a href="/docs/external-clients/">External Clients Guide →</a>
        </div>
      </div>
    </section>

    <!-- Full CI-Tested Support Matrix & Honest Limits -->
    <section id="supported-matrix" class="mt-12" aria-labelledby="support-matrix-heading">
      <h2 id="support-matrix-heading" class="text-2xl font-semibold mb-4">
        Supported platforms, backends &amp; explicit limits
      </h2>
      <SupportedMatrix />
    </section>
  </div>
</BaseLayout>
