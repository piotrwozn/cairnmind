---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { COMPARISON_PAGES, HOME_COMPARISON_MATRIX } from '@/data/comparisons';
import { breadcrumbListJsonLd } from '@/lib/seo';

const pathname = '/compare/';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: pathname },
];
const jsonLd = [breadcrumbListJsonLd(crumbs)];
---

<BaseLayout
  title="Compare Cairnmind vs. CLAUDE.md, Memory & RAG MCPs"
  description="Honest side-by-side comparison of Cairnmind against CLAUDE.md files, built-in assistant memory, and vector or MCP memory servers."
  pathname={pathname}
  jsonLd={jsonLd}
>
  <div class="container-shell section-band">
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <p class="eyebrow">Technical Comparisons</p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold">
        How Cairnmind compares to other approaches
      </h1>
      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed">
        Every approach makes real engineering tradeoffs. Below is an honest matrix, including when a simpler tool is the better choice.
      </p>
    </header>

    <section class="mt-10" aria-labelledby="matrix-heading">
      <h2 id="matrix-heading" class="text-2xl font-semibold mb-4">Overview matrix</h2>
      <div class="table-wrap">
        <table class="cm-table">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col" class="cm-col-highlight text-[var(--text-strong)]">Cairnmind</th>
              <th scope="col">CLAUDE.md / AGENTS.md</th>
              <th scope="col">Built-in Assistant Memory</th>
              <th scope="col">Vector / MCP Memory Layer</th>
            </tr>
          </thead>
          <tbody>
            {HOME_COMPARISON_MATRIX.map((row) => (
              <tr>
                <td><strong>{row.criterion}</strong></td>
                <td class="cm-col-highlight"><strong class="text-[var(--text-strong)]">{row.cairnmind}</strong></td>
                <td>{row.files}</td>
                <td>{row.builtin}</td>
                <td>{row.plugin}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="deep-dives-heading">
      <h2 id="deep-dives-heading" class="text-2xl font-semibold mb-5">Detailed comparison guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {COMPARISON_PAGES.map((page) => (
          <a
            href={`/compare/${page.slug}/`}
            class="glass-surface glass-interactive p-6 no-underline flex flex-col justify-between gap-4"
          >
            <div>
              <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--accent)]">
                {page.eyebrow}
              </span>
              <h3 class="mt-2.5 text-xl font-semibold text-[var(--text-strong)]">{page.title}</h3>
              <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">{page.intro}</p>
            </div>
            <span class="font-mono text-xs text-[var(--accent)]">Read side-by-side table →</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
