---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The requested Cairnmind page could not be found."
  pathname="/404/"
  noindex={true}
>
  <div class="container-shell section-band">
    <div class="glass-elevated p-8 sm:p-12 max-w-2xl mx-auto text-center">
      <p class="eyebrow">404 · Not Found</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold">This cairn isn’t on the trail</h1>
      <p class="mt-4 text-base text-[var(--text-muted)]">
        The page you requested does not exist or moved. Jump straight to the product overview, installation guide, or canonical documentation.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn-primary">Product Overview</a>
        <a href="/install/" class="btn-secondary">Install</a>
        <a href="/docs/" class="btn-secondary">Documentation</a>
      </div>
    </div>
  </div>
</BaseLayout>
