---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { USE_CASE_PAGES } from '@/data/useCases';
import { breadcrumbListJsonLd } from '@/lib/seo';

const pathname = '/use-cases/';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use Cases', href: pathname },
];
const jsonLd = [breadcrumbListJsonLd(crumbs)];
---

<BaseLayout
  title="Cairnmind Use Cases: Handoffs, Test Gates & Code Graph"
  description="Real coding agent workflows solved by Cairnmind: Claude Code to Codex handoffs, fingerprint test gates, local SCIP code graphs, and Git memory."
  pathname={pathname}
  jsonLd={jsonLd}
>
  <div class="container-shell section-band">
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <p class="eyebrow">Technical Use Cases</p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold">
        Concrete problems Cairnmind solves in real repositories
      </h1>
      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed">
        Each guide below documents the exact failure mode, the Cairnmind commands that address it, what is mechanically guaranteed, and where known limits stand.
      </p>
    </header>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
      {USE_CASE_PAGES.map((uc) => (
        <a
          href={`/use-cases/${uc.slug}/`}
          class="glass-surface glass-interactive p-6 sm:p-7 no-underline flex flex-col justify-between gap-5"
        >
          <div>
            <span class="font-mono text-[11px] uppercase tracking-wider text-[var(--accent)]">
              {uc.eyebrow}
            </span>
            <h2 class="mt-2.5 text-2xl font-semibold text-[var(--text-strong)]">{uc.title}</h2>
            <p class="mt-3 text-sm text-[var(--text-muted)] leading-relaxed">{uc.problemStatement}</p>
          </div>
          <div class="pt-4 border-t border-[var(--glass-border)] flex items-center justify-between text-xs font-mono">
            <span class="text-[var(--text-dim)]">{uc.workflowSteps.length} documented CLI steps</span>
            <span class="text-[var(--accent)]">Read workflow →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
