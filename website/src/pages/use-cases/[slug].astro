---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import { USE_CASE_PAGES, type UseCasePageData } from '@/data/useCases';
import { breadcrumbListJsonLd, techArticleJsonLd } from '@/lib/seo';

export function getStaticPaths() {
  return USE_CASE_PAGES.map((uc) => ({
    params: { slug: uc.slug },
    props: { uc },
  }));
}

interface Props {
  uc: UseCasePageData;
}

const { uc } = Astro.props;
const pathname = `/use-cases/${uc.slug}/`;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use Cases', href: '/use-cases/' },
  { label: uc.shortTitle, href: pathname },
];
const jsonLd = [
  techArticleJsonLd({
    headline: uc.title,
    description: uc.metaDescription,
    pathname,
  }),
  breadcrumbListJsonLd(crumbs),
];
const others = USE_CASE_PAGES.filter((o) => o.slug !== uc.slug);
---

<BaseLayout
  title={uc.seoTitle}
  description={uc.metaDescription}
  pathname={pathname}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="container-shell section-band">
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <p class="eyebrow">{uc.eyebrow}</p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-semibold">{uc.title}</h1>
    </header>

    <section class="mt-8 glass-surface p-6 sm:p-8" aria-labelledby="problem-heading">
      <h2 id="problem-heading" class="text-xl font-semibold">The engineering problem</h2>
      <p class="mt-3 text-base text-[var(--text-primary)] leading-relaxed">{uc.problemStatement}</p>
    </section>

    <section class="mt-8 glass-surface p-6 sm:p-8" aria-labelledby="solution-heading">
      <h2 id="solution-heading" class="text-xl font-semibold">How Cairnmind enforces a better boundary</h2>
      <ul class="mt-4 space-y-3 text-sm sm:text-base text-[var(--text-primary)] pl-5">
        {uc.howCairnmindSolvesIt.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </section>

    <section class="mt-8" aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="text-2xl font-semibold mb-4">Concrete workflow</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {uc.workflowSteps.map((s) => (
          <div class="glass-elevated p-5 flex flex-col justify-between gap-3">
            <div>
              <p class="font-mono text-xs text-[var(--accent)] font-semibold">{s.step}</p>
              <pre class="code-block mt-2.5 text-xs"><code>$ {s.command}</code></pre>
            </div>
            <p class="text-sm text-[var(--text-muted)] leading-relaxed">{s.outcome}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="Guarantees and limits">
      <div class="glass-surface p-6">
        <span class="glass-pill glass-pill-ok">Mechanically Enforced</span>
        <h2 class="mt-3 text-xl font-semibold">What is guaranteed</h2>
        <ul class="mt-3 space-y-2.5 text-sm text-[var(--text-primary)] pl-5">
          {uc.guarantees.map((g) => (
            <li>{g}</li>
          ))}
        </ul>
      </div>
      <div class="glass-surface p-6">
        <span class="glass-pill glass-pill-warn">Honest Boundaries</span>
        <h2 class="mt-3 text-xl font-semibold">Known limits</h2>
        <ul class="mt-3 space-y-2.5 text-sm text-[var(--text-primary)] pl-5">
          {uc.limits.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 pt-8 border-t border-[var(--glass-border)] grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h2 class="text-lg font-semibold mb-3">Related documentation</h2>
        <ul class="space-y-2 list-none p-0 m-0">
          {uc.relatedDocs.map((d) => (
            <li>
              <a href={d.href} class="text-sm font-medium">{d.label} →</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold mb-3">More use cases</h2>
        <ul class="space-y-2 list-none p-0 m-0">
          {others.map((o) => (
            <li>
              <a href={`/use-cases/${o.slug}/`} class="text-sm font-medium">{o.title} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
