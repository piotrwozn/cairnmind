---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/astro/Breadcrumbs.astro';
import type { ComparisonPageData } from '@/data/comparisons';
import { COMPARISON_PAGES } from '@/data/comparisons';
import { renderInlineCode } from '@/data/faq';
import { breadcrumbListJsonLd, techArticleJsonLd } from '@/lib/seo';

interface Props {
  page: ComparisonPageData;
}

const { page } = Astro.props;
const pathname = `/compare/${page.slug}/`;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Compare', href: '/compare/' },
  { label: page.shortTitle, href: pathname },
];

const jsonLd = [
  techArticleJsonLd({
    headline: page.title,
    description: page.metaDescription,
    pathname,
  }),
  breadcrumbListJsonLd(crumbs),
];

const others = COMPARISON_PAGES.filter((c) => c.slug !== page.slug);
---

<BaseLayout
  title={page.seoTitle}
  description={page.metaDescription}
  pathname={pathname}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="container-shell section-band">
    <Breadcrumbs items={crumbs} />

    <header class="mt-5 max-w-3xl">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 class="mt-3 text-3xl sm:text-5xl font-semibold">{page.title}</h1>
      <p class="mt-5 text-lg text-[var(--text-muted)] leading-relaxed">{page.intro}</p>
    </header>

    <section class="mt-10" aria-labelledby="comparison-table-heading">
      <h2 id="comparison-table-heading" class="text-2xl font-semibold mb-4">
        Side-by-side technical comparison
      </h2>
      <div class="table-wrap">
        <table class="cm-table">
          <thead>
            <tr>
              <th scope="col">Dimension</th>
              <th scope="col">{page.shortTitle.replace(/^vs\.\s*/i, '')}</th>
              <th scope="col">Cairnmind</th>
            </tr>
          </thead>
          <tbody>
            {page.rows.map((row) => (
              <tr>
                <td><strong>{row.criterion}</strong></td>
                <td set:html={renderInlineCode(row.alternative)} />
                <td set:html={renderInlineCode(row.cairnmind)} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6" aria-label="Tradeoffs">
      <div class="glass-surface p-6">
        <span class="glass-pill">When the alternative is enough</span>
        <h2 class="mt-4 text-xl font-semibold">Keep it simpler when…</h2>
        <ul class="mt-4 space-y-3 text-sm text-[var(--text-primary)] pl-5">
          {page.whenAlternativeWins.map((item) => (
            <li set:html={renderInlineCode(item)} />
          ))}
        </ul>
      </div>

      <div class="glass-elevated p-6">
        <span class="glass-pill glass-pill-ok">When Cairnmind fits</span>
        <h2 class="mt-4 text-xl font-semibold">Use Cairnmind when…</h2>
        <ul class="mt-4 space-y-3 text-sm text-[var(--text-primary)] pl-5">
          {page.whenCairnmindWins.map((item) => (
            <li set:html={renderInlineCode(item)} />
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-10 glass-surface p-6 sm:p-8">
      <p class="eyebrow">Engineering Takeaway</p>
      <p class="mt-3 text-base sm:text-lg text-[var(--text-strong)] leading-relaxed" set:html={renderInlineCode(page.technicalTakeaway)} />
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/install/" class="btn-primary">Try in 15 seconds: uvx cairnmind try</a>
        <a href="/benchmarks/" class="btn-secondary">Read measured results</a>
      </div>
    </section>

    <section class="mt-12 pt-8 border-t border-[var(--glass-border)] grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <h2 class="text-lg font-semibold mb-3">Related documentation</h2>
        <ul class="space-y-2 list-none p-0 m-0">
          {page.relatedDocs.map((d) => (
            <li>
              <a href={d.href} class="text-sm font-medium">{d.label} →</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold mb-3">Other comparisons</h2>
        <ul class="space-y-2 list-none p-0 m-0">
          {others.map((o) => (
            <li>
              <a href={`/compare/${o.slug}/`} class="text-sm font-medium">{o.title} →</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
